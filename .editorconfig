root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,c,cmake,txt}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.{gd,tscn,godot,gdextension}]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,md,svg}]
indent_style = space
indent_size = 2
